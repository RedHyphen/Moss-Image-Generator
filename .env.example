# Web app: loopback-only bind. Use an explicit private or link-local address
# and trusted subnet allowlist only when LAN access is intentionally enabled.
MOSS_HOST=127.0.0.1
MOSS_PORT=8002
MOSS_TRUSTED_SUBNETS=
MOSS_COOKIE_SECURE=false
MOSS_LOCAL_ONLY=true
MOSS_DATA_DIR=./data
MOSS_MODELS_DIR=./data/models
MOSS_MAX_UPLOAD_MB=25
MOSS_MAX_UPLOAD_COUNT=8
# Combined persistent uploads and generated rasters; model caches are separate.
MOSS_MAX_MEDIA_MB=50000
# Automatically reserve 20% VRAM headroom and round down to a standard pixel
# budget. Set a numeric value only when intentionally overriding auto sizing.
MOSS_MAX_PIXELS=auto
# Process-wide active generation limit shared by all accounts.
MOSS_MAX_QUEUE=1
MOSS_INFERENCE_TIMEOUT_SECONDS=3600
# Only needed when upgrading a legacy database that has unowned records and
# more than one account. Never guess which account should receive that data.
MOSS_LEGACY_OWNER_USERNAME=

# `./scripts/dev.sh` defaults to loopback. Set these only when a development
# browser needs a different host, port, or API target.
MOSS_DEV_HOST=127.0.0.1
MOSS_DEV_PORT=8000
MOSS_DEV_API_URL=http://127.0.0.1:8000
MOSS_DEV_FRONTEND_HOST=127.0.0.1

# Local vLLM-Omni image endpoint. Both the web app and image worker are
# loopback-only by default.
# Docker launcher allowlist accepts the official MOSS/vLLM-Omni images below.
# Keep this false; third-party images require a separate executable-code review.
MOSS_ALLOW_UNTRUSTED_VLLM_IMAGE=false
# Use the rolling official image until the stable MOSS tags include the
# MOSSImagePipeline registration and matching CUDA dependency set.
VLLM_IMAGE=vllm/vllm-omni:nightly
MOSS_VLLM_URL=http://127.0.0.1:8001
MOSS_MODEL=OpenMOSS-Team/MOSS-Image-SFT
# Native local mode may point at a pinned local checkpoint directory instead of
# downloading the same model into the default Hugging Face cache. Leave blank
# for Docker/Hugging Face-cache mode. The directory must contain model_index.json.
MOSS_MODEL_PATH=
# Loopback-only operation may leave this empty. Set a secret if the local
# worker should still require bearer authentication.
VLLM_API_KEY=
# Keep false. The image worker must remain local; public inference endpoints
# require an explicit review and this opt-in.
MOSS_ALLOW_EXTERNAL_INFERENCE=false
# Set true after all required resources are cached. This disables application-
# external-inference opt-in. Set HF_HUB_OFFLINE=1 separately after the local
# model cache is populated to prevent vLLM from attempting downloads.
MOSS_OFFLINE_MODE=false

# Optional OpenAI-compatible vLLM chat endpoint for prompt/layout assistance.
VLLM_CHAT_URL=
VLLM_CHAT_MODEL=
# Optional local structured router. Disabled by default to avoid loading a
# second model during image generation; it receives text and asset flags only.
MOSS_ROUTER_ASSISTANCE=false

# MOSS-Image is the only active image backend. Uploaded-image editing is not
# enabled because the MOSS image API has no verified image-conditioned input.
MOSS_ONLY_MODE=true

# Local worker options. This is the recommended 8GB VRAM profile. It uses
# experimental FP16 plus
# layerwise host offload; generation is slower but stays within the local GPU
# memory budget more reliably than resident BF16.
MOSS_GPU_PROFILE=8gb-turing
VLLM_MODE=native
VLLM_HOST=127.0.0.1
VLLM_PORT=8001
CUDA_VISIBLE_DEVICES=0
MOSS_ALLOW_FP16_EXPERIMENTAL=true
VLLM_DTYPE=float16
MOSS_VLLM_CPU_OFFLOAD=false
# vLLM-Omni's layerwise diffusion offload is required for this 8GB profile.
MOSS_VLLM_DIFFUSION_OFFLOAD_CONFIG='{"mode":"layer","components":["dit","text_encoder"],"layer_options":{"dit":{"weight_transfer":"rank-local"},"text_encoder":{"weight_transfer":"rank-local"}},"pin_memory":true}'
# Keep one GPU and one queued request on 8GB Turing hardware.
# Higher-memory hosts may explicitly use CUDA_VISIBLE_DEVICES=0,1 with a
# separately validated VLLM_TENSOR_PARALLEL_SIZE=2 profile.
VLLM_TENSOR_PARALLEL_SIZE=1
# Native loopback worker may run without a key only when this explicit flag is
# true; it is never a LAN/public unauthenticated mode.
MOSS_ALLOW_UNAUTHENTICATED_VLLM=false
MOSS_ALLOW_LOOPBACK_UNAUTHENTICATED_VLLM=true
